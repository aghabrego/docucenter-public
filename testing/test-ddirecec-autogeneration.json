{
  "name": "Test dDirecRec Auto-generation",
  "description": "JSON de prueba específico para validar la generación automática de dDirecRec",
  "scenarios": [
    {
      "name": "iTipoRec 01 - dDirecRec ausente",
      "data": {
        "dDatRec": {
          "iTipoRec": "01",
          "dRuc": "123456789",
          "dDV": "12",
          "dNombRec": "Juan Pérez",
          "dProv": "8",
          "dDistr": "8-1"
        },
        "expected_dDirecRec": "Provincia de PANAMÁ, Distrito de PANAMÁ"
      }
    },
    {
      "name": "iTipoRec 1 - dDirecRec vacío",
      "data": {
        "dDatRec": {
          "iTipoRec": "1",
          "dRuc": "123456789",
          "dDV": "12",
          "dNombRec": "Juan Pérez",
          "dDirecRec": "   ",
          "dProv": "8",
          "dDistr": "8-1"
        },
        "expected_dDirecRec": "Provincia de PANAMÁ, Distrito de PANAMÁ"
      }
    },
    {
      "name": "iTipoRec 03 - dDirecRec ausente",
      "data": {
        "dDatRec": {
          "iTipoRec": "03",
          "dRuc": "987654321",
          "dDV": "21",
          "dNombRec": "John Smith",
          "dProv": "1",
          "dDistr": "1-1"
        },
        "expected_dDirecRec": "Provincia de BOCAS DEL TORO, Distrito de BOCAS DEL TORO"
      }
    },
    {
      "name": "iTipoRec 3 - dDirecRec vacío",
      "data": {
        "dDatRec": {
          "iTipoRec": "3",
          "dRuc": "987654321",
          "dDV": "21",
          "dNombRec": "John Smith",
          "dDirecRec": "",
          "dProv": "5",
          "dDistr": "5-2"
        },
        "expected_dDirecRec": "Provincia de HERRERA, Distrito de CHITRÉ"
      }
    },
    {
      "name": "Sin datos de provincia - fallback",
      "data": {
        "dDatRec": {
          "iTipoRec": "01",
          "dRuc": "123456789",
          "dDV": "12",
          "dNombRec": "María López"
        },
        "expected_dDirecRec": "PANAMÁ"
      }
    },
    {
      "name": "iTipoRec 02 - no debe autogenerar",
      "data": {
        "dDatRec": {
          "iTipoRec": "02",
          "dRuc": "555666777",
          "dDV": "88",
          "dNombRec": "Empresa XYZ"
        },
        "expected_dDirecRec": null
      }
    }
  ]
}
